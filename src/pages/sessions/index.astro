---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Four sessions, not twelve, placed where the chain needs hands on it rather than another lecture."
  {...siteConfig}
>
  <p>
    Twelve lectures build the chain. Four sessions are where you stop reading
    about it and do it: plot the real CMB spectrum against a blackbody curve
    you compute yourself, count every microstate of a system small enough to
    list by hand, redo the Sun's lifetime estimate on paper, and work out what
    degeneracy pressure can and cannot hold up before gravity wins. Each one
    sits at the point in the chain where an argument alone stops being
    enough.
  </p>
  <SessionsGrid />
</ContentLayout>
